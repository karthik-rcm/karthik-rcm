# Secrets / credentials
.env
.env.*
*.pem
*.key
aws-credentials*
credentials.json

# AWS sandbox local state
.aws/
.terraform/
*.tfstate
*.tfstate.backup
*.tfvars

# Practice exam dumps (often copyrighted)
**/practice-exams-paid/
**/tutorialsdojo/
**/whizlabs/

# AWS course material (copyrighted, login-gated — never commit to public repo)
# Scoped to AWS training artifacts, NOT all PDFs — a sanitized case-study PDF is allowed.
**/*Review*.pdf
**/*AWS*Certified*.pdf
**/*Skill*Builder*.pdf

# Local Claude settings (machine-specific, not study evidence)
.claude/settings.local.json

# Local scratch (transcripts stay ignored; the field book is tracked)
scratch/*
!scratch/visuals/
scratch/visuals/*
!scratch/visuals/fde-course-map.html
tmp/
*.swp
.DS_Store

# Loom / video raw exports (large)
*.mov
*.mp4

# Python / Node sandbox
__pycache__/
*.pyc
node_modules/
.venv/
venv/

